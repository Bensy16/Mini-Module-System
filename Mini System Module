# Helper Function
def get_float(prompt):
    while True:
        try:
            print(prompt, end="", flush=True)
            sys.stdout.flush()
            return float(input())
        except ValueError:
            print(" >> Invalid Input. Please Type a number(e.g, 3,3.5, -2).")
        except EOFError:
            print("\n >> No Input recieved. Exiting Program.")
            raise SystemExit

def get_int(prompt):
    while True:
        try:
            print(prompt, end="", flush=True)
            sys.stdout.flush()
            return int(input())
        except ValueError:
            print(" >> Invalid Input. Please type a Whole number (e.g,5, -3,0).")
        except EOFError:
            print("\n >> No Input recieved. Exiting Program.")
            raise SystemExit

def safe_input(prompt):
    while True:
        try:
            print(prompt, end="", flush=True)
            sys.stdout.flush()
            return input()
        except EOFError:
            print("\n >> No Input recieved. Exiting Program.")
            raise SystemExit

def pause():
    """Pauses so the user can read the result to the menu. Reappears."""
    safe_input("\nPress ENTER to return to the menu. . .")
def print_header(title):
    print("\n" + "=" * 70)
    print("f{title}")
    print("=", * 70)

