        print(f"\n hypot({a}, {b}) = {math.hypot(a, b)}")

    elif choice == "0":
        return
    else:
        print("\nInvalid Choice.")

    pause()


# SECTION 5: THE RANDOM MODULE
def random_menu():
    print_header("THE RANDOM MODULE")
    print("""
    1. Set a seed (so results can be repeated)
    2. Generate a number with randrange()
    3. Generate a number with randint()
    4. Pick a random item from a list with choice()
    5. Draw several UNIQUE items from a list with sample() (like a lottery)
    0. Back to Main Menu
    """)

    choice = safe_input("What is your Choice: ").strip()

    if choice == "1":
        seed_val = get_int("Enter a seed value: ")
        random.seed(seed_val)
        print(f"\n Random seed set to {seed_val}")

    elif choice == "2":
        start = get_int("Enter start of range: ")
        stop = get_int("Enter end of range: ")
        print(f"\n randrange({start}, {stop}) = {random.randrange(start, stop)}")

    elif choice == "3":
        a = get_int("Enter lower bound: ")
        b = get_int("Enter upper bound: ")
        print(f"\n randint({a}, {b}) = {random.randint(a, b)}")

    elif choice == "4":
        items = safe_input("Enter items separated by commas: ").split(",")
        items = [item.strip() for item in items if item.strip()]
        if items:
            print(f"\n choice({items}) = {random.choice(items)}")
        else:
            print("No valid items entered.")

    elif choice == "5":
        items = safe_input("Enter items separated by commas: ").split(",")
        items = [item.strip() for item in items if item.strip()]
        k = get_int("How many items to draw? ")
        try:
            print(f"\n sample({items}, {k}) = {random.sample(items, k)}")
        except ValueError:
            print(" sample(k) requires k <= len(items). Skipped.")

    elif choice == "0":
        return
    else:
        print("\nInvalid Choice.")

    pause()
